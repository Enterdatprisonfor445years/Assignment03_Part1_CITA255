<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CITA255_Midterm"
             x:Class="CITA255_Midterm.App">
    <Application.Resources>
        <ResourceDictionary>
            <Style x:Key="GameTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="TextColor" Value="#FFFFFF"/>
            </Style>
            <Style x:Key="GameInfoStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="TextColor" Value="#CCCCCC"/>
            </Style>
            <Style x:Key="AddToCartButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#512BD4"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
