<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255_Midterm.GearsOfWar"
             Title="GearsOfWar">
    <ScrollView>
        <VerticalStackLayout>
            <Image Source="gears.jpg"
                   HorizontalOptions="Center"/>
            <Label 
                Text="Gears of war E Day"
                Style="{StaticResource GameTitleStyle}"/>
            <Label 
                Text="$69.99"/>
            <Label 
                Text="Third-Person Shooter"
                Style="{StaticResource GameInfoStyle}"/>
            <Label 
                Text="In Stock"/>
            <Entry
                x:Name="QtyEntry"
                Placeholder="Enter a Quantity!"/>
            <Button
                x:Name="AddToCartButton"
                Text="Add to Cart"
                Clicked="Button_Clicked"
                Style="{StaticResource AddToCartButtonStyle}"/>
            <Label 
                x:Name="MessageLabel" 
                Text="" 
                HorizontalOptions="Center" 
                FontAttributes="Bold"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>